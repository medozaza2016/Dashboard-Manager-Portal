{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dashboard-manager-portal",
  "compatibility_date": "2026-10-29",
  "pages_build_output_dir": "./dist",
  "r2_buckets": [
    {
      "binding": "R2_LOGOS",
      "bucket_name": "dashboard-manager-portal-assets"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "luxorit-portal-db",
      "database_id": "c6df7b2f-9d75-459c-a93a-319c95c193a5",
      "preview_database_id": "DB"
    }
  ],
  "vars": {
    "CF_ACCOUNT_ID": "4ed0b7cda99d43ce679d2aace4d3f525",
    "ACCESS_TEAM_DOMAIN": "luxoritpro.cloudflareaccess.com",
    "ACCESS_AUD": "400cb43b379c14419790dc02aa2eef6a0254aafe87aa905f7161c7c89911a702"
  }
}
